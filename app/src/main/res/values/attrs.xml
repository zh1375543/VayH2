<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="ShapeView">
        <attr name="shape" format="enum">
            <enum name="rectangle" value="0" />
            <enum name="oval" value="1" />
            <enum name="line" value="2" />
            <enum name="ring" value="3" />
        </attr>
        <attr name="radius" format="dimension" />
        <attr name="left_top_radius" format="dimension" />
        <attr name="right_top_radius" format="dimension" />
        <attr name="right_bottom_radius" format="dimension" />
        <attr name="left_bottom_radius" format="dimension" />

        <attr name="solidColor" format="color" />
        <attr name="strokeWidth" format="dimension" />
        <attr name="strokeColor" format="color" />

        <attr name="pressedColor" format="color" />
        <attr name="selectedColor" format="color" />
        <attr name="disabledColor" format="color" />

        <attr name="pressedStrokeColor" format="color" />
        <attr name="focusedStrokeColor" format="color" />
        <attr name="selectedStrokeColor" format="color" />
        <attr name="disabledStrokeColor" format="color" />

        <attr name="autoFillPressedColor" format="boolean" />

        <attr name="textColorPressed" format="color" />
        <attr name="textColorSelected" format="color" />
        <attr name="textColorDisabled" format="color" />

        <!-- Dashed line support -->
        <attr name="dashWidth" format="dimension" />
        <attr name="dashGap" format="dimension" />

        <attr name="drawableStartSelected" format="reference" />
        <attr name="drawableEndSelected" format="reference" />
        <attr name="drawableTopSelected" format="reference" />
        <attr name="drawableBottomSelected" format="reference" />

        <attr name="drawableWidth" format="dimension" />
        <attr name="drawableHeight" format="dimension" />

        <!-- Gradient direction -->
        <attr name="gradientOrientation" format="enum">
            <enum name="LEFT_RIGHT" value="0"/>
            <enum name="RIGHT_LEFT" value="1"/>
            <enum name="TOP_BOTTOM" value="2"/>
            <enum name="BOTTOM_TOP" value="3"/>
            <enum name="TL_BR" value="4"/>
            <enum name="TR_BL" value="5"/>
            <enum name="BL_TR" value="6"/>
            <enum name="BR_TL" value="7"/>
        </attr>
        <!-- Normal state gradient -->
        <attr name="gradientStartColor" format="color"/>
        <attr name="gradientEndColor" format="color"/>
        <attr name="gradientCenterColor" format="color"/>
        <!-- Pressed state gradient -->
        <attr name="pressedGradientStartColor" format="color"/>
        <attr name="pressedGradientEndColor" format="color"/>
        <!-- Selected state gradient -->
        <attr name="selectedGradientStartColor" format="color"/>
        <attr name="selectedGradientEndColor" format="color"/>
        <!-- Disabled state gradient -->
        <attr name="disabledGradientStartColor" format="color"/>
        <attr name="disabledGradientEndColor" format="color"/>
    </declare-styleable>

    <declare-styleable name="SurfacePanelLayout">
        <attr name="panelCornerRadius" format="dimension" />
        <attr name="panelTopLeftRadius" format="dimension" />
        <attr name="panelTopRightRadius" format="dimension" />
        <attr name="panelBottomRightRadius" format="dimension" />
        <attr name="panelBottomLeftRadius" format="dimension" />

        <attr name="panelFillColor" format="color" />
        <attr name="panelBorderWidth" format="dimension" />
        <attr name="panelBorderColor" format="color" />

        <attr name="panelPressedFillColor" format="color" />
        <attr name="panelSelectedFillColor" format="color" />
        <attr name="panelDisabledFillColor" format="color" />

        <attr name="panelPressedBorderColor" format="color" />
        <attr name="panelFocusedBorderColor" format="color" />
        <attr name="panelSelectedBorderColor" format="color" />
        <attr name="panelDisabledBorderColor" format="color" />

        <attr name="panelDerivePressedState" format="boolean" />

        <attr name="panelGradientDirection" format="enum">
            <enum name="leftToRight" value="0" />
            <enum name="rightToLeft" value="1" />
            <enum name="topToBottom" value="2" />
            <enum name="bottomToTop" value="3" />
            <enum name="topLeftToBottomRight" value="4" />
            <enum name="topRightToBottomLeft" value="5" />
            <enum name="bottomLeftToTopRight" value="6" />
            <enum name="bottomRightToTopLeft" value="7" />
        </attr>

        <attr name="panelGradientStartColor" format="color" />
        <attr name="panelGradientCenterColor" format="color" />
        <attr name="panelGradientEndColor" format="color" />

        <attr name="panelPressedGradientStartColor" format="color" />
        <attr name="panelPressedGradientEndColor" format="color" />
        <attr name="panelSelectedGradientStartColor" format="color" />
        <attr name="panelSelectedGradientEndColor" format="color" />
        <attr name="panelDisabledGradientStartColor" format="color" />
        <attr name="panelDisabledGradientEndColor" format="color" />
    </declare-styleable>

    <declare-styleable name="CurvedHeaderLayout">
        <attr name="curvedHeaderFillColor" format="color" />
        <attr name="curvedHeaderArcDepth" format="dimension" />
        <attr name="curvedHeaderContentSpacing" format="dimension" />
    </declare-styleable>

    <declare-styleable name="StyledEditTextView">
        <attr name="validationSuccessDrawable" format="reference" />
        <attr name="validationErrorDrawable" format="reference" />
    </declare-styleable>

    <declare-styleable name="StatefulLabelView">
        <attr name="labelCornerRadius" format="dimension" />
        <attr name="labelTopLeftRadius" format="dimension" />
        <attr name="labelTopRightRadius" format="dimension" />
        <attr name="labelBottomRightRadius" format="dimension" />
        <attr name="labelBottomLeftRadius" format="dimension" />
        <attr name="labelFillColor" format="color" />
        <attr name="labelBorderWidth" format="dimension" />
        <attr name="labelBorderColor" format="color" />
        <attr name="labelPressedFillColor" format="color" />
        <attr name="labelSelectedFillColor" format="color" />
        <attr name="labelDisabledFillColor" format="color" />
        <attr name="labelPressedBorderColor" format="color" />
        <attr name="labelFocusedBorderColor" format="color" />
        <attr name="labelSelectedBorderColor" format="color" />
        <attr name="labelDisabledBorderColor" format="color" />
        <attr name="labelDerivePressedState" format="boolean" />
        <attr name="labelPressedTextColor" format="color" />
        <attr name="labelSelectedTextColor" format="color" />
        <attr name="labelDisabledTextColor" format="color" />
        <attr name="labelSelectedDrawableStart" format="reference" />
        <attr name="labelSelectedDrawableTop" format="reference" />
        <attr name="labelSelectedDrawableEnd" format="reference" />
        <attr name="labelSelectedDrawableBottom" format="reference" />
        <attr name="labelDrawableWidth" format="dimension" />
        <attr name="labelDrawableHeight" format="dimension" />
        <attr name="labelGradientDirection" format="enum">
            <enum name="leftToRight" value="0" />
            <enum name="rightToLeft" value="1" />
            <enum name="topToBottom" value="2" />
            <enum name="bottomToTop" value="3" />
            <enum name="topLeftToBottomRight" value="4" />
            <enum name="topRightToBottomLeft" value="5" />
            <enum name="bottomLeftToTopRight" value="6" />
            <enum name="bottomRightToTopLeft" value="7" />
        </attr>
        <attr name="labelGradientStartColor" format="color" />
        <attr name="labelGradientCenterColor" format="color" />
        <attr name="labelGradientEndColor" format="color" />
        <attr name="labelPressedGradientStartColor" format="color" />
        <attr name="labelPressedGradientEndColor" format="color" />
        <attr name="labelSelectedGradientStartColor" format="color" />
        <attr name="labelSelectedGradientEndColor" format="color" />
        <attr name="labelDisabledGradientStartColor" format="color" />
        <attr name="labelDisabledGradientEndColor" format="color" />
    </declare-styleable>
    <declare-styleable name="SelectableImageView">
        <attr name="srcSelected" format="reference" />
        <attr name="android:src" />
    </declare-styleable>
    <declare-styleable name="CloudLoadingView">
        <attr name="cl_barColor" format="color" />
        <attr name="cl_barCount" format="integer" />
        <attr name="cl_barWidth" format="dimension" />
        <attr name="cl_barSpacing" format="dimension" />
        <attr name="cl_radius" format="dimension" />
        <attr name="cl_minHeightRatio" format="float" /> <!-- Height ratio relative to View (0~1) -->
        <attr name="cl_maxHeightRatio" format="float" /> <!-- Height ratio relative to View (0~1) -->
        <attr name="cl_duration" format="integer" /> <!-- ms -->
    </declare-styleable>
    <declare-styleable name="RepaymentTimelineConnectorView">
        <attr name="connectorColor" format="color" />
        <attr name="connectorWidth" format="dimension" />
    </declare-styleable>
    <declare-styleable name="FormItemView">
        <attr name="titleText" format="string" />
        <attr name="hintText" format="string" />
        <attr name="errorText" format="string" />
        <attr name="prefixText" format="string" />

        <attr name="formType">
            <enum name="input" value="0" />
            <enum name="select" value="1" />
        </attr>

        <attr name="inputType">
            <enum name="text" value="0" />
            <enum name="number" value="1" />
            <enum name="phone" value="2" />
            <enum name="email" value="3"/>
        </attr>

        <!-- Additional attributes -->
        <attr name="editMaxLength" format="integer" />
        <attr name="showContactIcon" format="boolean" />
        <attr name="formEndIcon" format="reference" />
        <attr name="inputBackgroundColor" format="color" />
        <attr name="inputStrokeColor" format="color" />
        <attr name="inputFocusedStrokeColor" format="color" />
        <attr name="titleTextColor" format="color" />
    </declare-styleable>
    <declare-styleable name="PageHeaderView">
        <attr name="centerText" format="string" />
        <attr name="rightText" format="string" />
        <attr name="rightImage" format="reference" />
        <attr name="showRightImage" format="boolean" />
        <attr name="tintColor" format="color"/>
        <attr name="navigationIconColor" format="color" />
        <attr name="navigationMarginStart" format="dimension" />
        <attr name="fitStatusBar" format="boolean" />
    </declare-styleable>


    <!--sssss-->
    <declare-styleable name="StatefulActionButton">
        <attr name="actionButtonVariant" format="enum">
            <enum name="filled" value="0" />
            <enum name="outline" value="1" />
        </attr>
        <attr name="buttonRadius" format="dimension" />
        <attr name="buttonSolidColor" format="color|reference" />
        <attr name="buttonPressedColor" format="color|reference" />
        <attr name="buttonDisabledColor" format="color|reference" />
        <attr name="buttonStrokeWidth" format="dimension" />
        <attr name="buttonStrokeColor" format="color|reference" />
        <attr name="buttonTextColor" format="color|reference" />
        <attr name="buttonDisabledTextColor" format="color|reference" />
        <attr name="buttonDisabledAlpha" format="float" />
    </declare-styleable>

    <declare-styleable name="DecoratedTitleView">
        <attr name="decoratedTitleText" format="string" />
        <attr name="decoratedTitleTextColor" format="color|reference" />
        <attr name="decoratedTitleTextSize" format="dimension" />
        <attr name="decoratedTitleIcon" format="reference" />
        <attr name="decoratedTitleIconSize" format="dimension" />
        <attr name="decoratedTitleIconGap" format="dimension" />
    </declare-styleable>

</resources>
