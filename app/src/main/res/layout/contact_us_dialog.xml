<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.velora.portal.platform.design.component.SurfacePanelLayout
        android:id="@+id/cardLayout"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:panelGradientEndColor="@color/text_inverse"
        app:panelGradientDirection="topToBottom"
        app:panelGradientStartColor="@color/color_order_over"
        app:panelCornerRadius="@dimen/dp_12" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivCustomer"
        android:layout_width="@dimen/dp_180"
        android:layout_height="@dimen/dp_84"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_8"
        android:contentDescription="@null"
        android:scaleType="fitEnd"
        android:src="@mipmap/ic_dialog_contact_tip"
        app:layout_constraintEnd_toEndOf="@id/cardLayout"
        app:layout_constraintTop_toTopOf="@id/cardLayout" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_8"
        android:ellipsize="end"
        android:gravity="start"
        app:layout_constrainedWidth="true"
        android:maxLines="1"
        android:text="@string/contact_us"
        android:textColor="@color/brand_primary"
        android:textSize="@dimen/sp_20"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/ivCustomer"
        app:layout_constraintStart_toStartOf="@id/cardLayout"
        app:layout_constraintTop_toTopOf="@id/cardLayout" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCustomer"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_20"
        android:orientation="vertical"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/cardLayout"
        app:layout_constraintStart_toStartOf="@id/cardLayout"
        app:layout_constraintTop_toBottomOf="@id/ivCustomer"
        tools:itemCount="2"
        tools:listitem="@layout/item_support_contact" />

</androidx.constraintlayout.widget.ConstraintLayout>
