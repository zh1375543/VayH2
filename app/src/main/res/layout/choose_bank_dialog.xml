<?xml version="1.0" encoding="utf-8"?>
<com.velora.portal.platform.design.component.SurfacePanelLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/dp_20"
    app:panelTopLeftRadius="@dimen/dp_20"
    app:panelTopRightRadius="@dimen/dp_20"
    app:panelFillColor="@color/page_bg_color1">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:gravity="center"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/select_bank"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" />

    <com.velora.portal.platform.design.component.StyledEditTextView
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_12"
        android:drawablePadding="@dimen/dp_8"
        android:drawableStart="@mipmap/icon_bank_find"
        android:gravity="center_vertical"
        android:hint="@string/search"
        tools:text="XXXXX"
        android:paddingVertical="@dimen/dp_10"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/dp_16"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="@dimen/sp_13"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:radius="@dimen/dp_24"
        app:solidColor="@color/surface_primary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBank"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_500"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginBottom="@dimen/dp_16"
        android:orientation="vertical"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/etSearch"
        tools:itemCount="4"
        tools:listitem="@layout/item_bank_option" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_500"
        android:gravity="center"
        android:text="@string/empty_search"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/sp_12"
        app:layout_constraintTop_toBottomOf="@id/etSearch" />

</com.velora.portal.platform.design.component.SurfacePanelLayout>
