<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.velora.portal.platform.design.component.SurfacePanelLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="@dimen/dp_20"
        app:panelCornerRadius="@dimen/dp_16"
        app:panelFillColor="@color/text_inverse">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_20"
            android:gravity="center"
            android:text="@string/dialog_feedback_title"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_18"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent" />

        <com.velora.portal.platform.design.component.StyledEditTextView
            android:id="@+id/etFeedbackMessage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_180"
            android:layout_margin="20dp"
            android:gravity="start"
            android:hint="@string/enter_feedback"
            android:padding="@dimen/dp_12"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="@dimen/sp_14"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:radius="@dimen/dp_16"
            app:solidColor="@color/surface_secondary" />

        <com.velora.portal.platform.design.component.StyledTextView
            android:id="@+id/btnSubmitFeedback"
            style="@style/mainButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginBottom="@dimen/dp_20"
            android:text="@string/submit"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etFeedbackMessage" />

    </com.velora.portal.platform.design.component.SurfacePanelLayout>
</FrameLayout>
