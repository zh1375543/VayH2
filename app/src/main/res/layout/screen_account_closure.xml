<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/page_bg_color1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.velora.portal.platform.design.component.PageHeaderView
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:centerText="@string/close_account"
        app:layout_constraintTop_toTopOf="parent" />

    <com.velora.portal.platform.design.component.SurfacePanelLayout
        android:id="@+id/top_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_14"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintTop_toBottomOf="@id/titleBar"
        app:panelCornerRadius="@dimen/dp_12"
        app:panelGradientDirection="leftToRight"
        app:panelGradientEndColor="@color/brand_primary_light"
        app:panelGradientStartColor="@color/brand_secondary">

        <TextView
            android:id="@+id/tvAppName"
            style="@style/LogoutAccountValueText"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/app_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvAccount"
            style="@style/LogoutAccountValueText"
            android:layout_marginTop="@dimen/dp_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAppName"
            tools:text="000" />

        <TextView
            style="@style/LogoutAccountLabelText"
            android:text="@string/close_app_name"
            app:layout_constraintBottom_toBottomOf="@id/tvAppName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvAppName" />

        <TextView
            style="@style/LogoutAccountLabelText"
            android:text="@string/account_number"
            app:layout_constraintBottom_toBottomOf="@id/tvAccount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvAccount" />

        <View
            android:id="@+id/accountDivider"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_1"
            android:layout_marginHorizontal="@dimen/dp_18"
            android:layout_marginTop="@dimen/dp_14"
            android:background="@color/p40_FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAccount" />

        <com.velora.portal.platform.design.component.StatefulLabelView
            android:id="@+id/tvTips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_18"
            android:layout_marginTop="@dimen/dp_14"
            android:layout_marginBottom="@dimen/dp_16"
            android:lineSpacingExtra="@dimen/dp_4"
            android:text="@string/close_account_tips"
            android:textColor="@color/text_inverse"
            android:textSize="@dimen/sp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/accountDivider"
            app:solidColor="@color/transparent" />
    </com.velora.portal.platform.design.component.SurfacePanelLayout>

    <Space
        android:id="@+id/tipsBottomSpace"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_15"
        app:layout_constraintEnd_toEndOf="@id/top_layout"
        app:layout_constraintStart_toStartOf="@id/top_layout"
        app:layout_constraintTop_toBottomOf="@id/top_layout" />

    <com.velora.portal.platform.design.component.StyledLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_8"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvSelectTitle"
        app:radius="@dimen/dp_12"
        app:solidColor="@color/transparent">

        <com.velora.portal.platform.design.component.StatefulLabelView
            android:id="@+id/tvReason1"
            style="@style/LogoutReasonItem"
            android:text="@string/close_account_reason1" />

        <com.velora.portal.platform.design.component.StatefulLabelView
            android:id="@+id/tvReason2"
            style="@style/LogoutReasonItem"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/close_account_reason2" />

        <com.velora.portal.platform.design.component.StatefulLabelView
            android:id="@+id/tvReason3"
            style="@style/LogoutReasonItem"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/close_account_reason3" />

        <com.velora.portal.platform.design.component.StatefulLabelView
            android:id="@+id/tvReason4"
            style="@style/LogoutReasonItem"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/close_account_reason4" />

    </com.velora.portal.platform.design.component.StyledLinearLayout>

    <TextView
        android:id="@+id/tvSelectTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_8"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/dp_4"
        android:text="@string/close_account_reason"
        android:textColor="@color/black"
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tipsBottomSpace" />
    <com.velora.portal.platform.design.component.StatefulActionButton
        android:id="@+id/btnSubmit"
         android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginHorizontal="@dimen/dp_34"
        android:layout_marginBottom="@dimen/dp_20"
        android:text="@string/submit"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
