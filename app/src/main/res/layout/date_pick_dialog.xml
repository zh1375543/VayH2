<?xml version="1.0" encoding="utf-8"?>
<com.velora.portal.platform.design.component.SurfacePanelLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/dp_20"
    app:panelTopLeftRadius="@dimen/dp_20"
    app:panelTopRightRadius="@dimen/dp_20"
    app:panelFillColor="@color/text_inverse">

    <com.velora.portal.platform.design.component.WheelDateView
        android:id="@+id/dateView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_200"
        android:maxHeight="@dimen/dp_500"
        app:layout_constraintTop_toTopOf="parent" />

    <com.velora.portal.platform.design.component.StatefulLabelView
        android:id="@+id/tvOk"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginHorizontal="@dimen/dp_40"
        android:layout_marginVertical="@dimen/dp_20"
        style="@style/mainButton"
        android:text="@string/ok"
        app:layout_constraintTop_toBottomOf="@id/dateView"/>

</com.velora.portal.platform.design.component.SurfacePanelLayout>
