<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/page_bg_color1"
    android:layout_height="match_parent">

    <com.velora.portal.core.ui.component.PageHeaderView
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:centerText="@string/cert_center"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvCertTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:text="@string/certification"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/sp_20"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/titleBar" />

    <com.velora.portal.core.ui.component.StyledTextView
        android:id="@+id/tvTips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_4"
        android:gravity="center"
        android:text="@string/cert_desc"
        android:textColor="@color/text_body"
        android:textSize="@dimen/sp_14"
        android:textStyle="normal"
        app:layout_constraintTop_toBottomOf="@id/tvCertTitle" />

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTips">

        <com.velora.portal.core.ui.component.StyledRecyclerView
            android:id="@+id/rvAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_18"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:orientation="vertical"
            android:overScrollMode="never"
            android:visibility="visible"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:radius="@dimen/dp_12"
            app:solidColor="@color/surface_primary"
            app:layout_constraintTop_toTopOf="parent"
            tools:listitem="@layout/item_auth_entry" />

        <com.velora.portal.core.ui.component.PageStateOverlayView
            android:id="@+id/pageState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
