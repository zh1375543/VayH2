<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_page_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/detailHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_sava_salary_bg" />

                <com.velora.portal.platform.design.component.PageHeaderView
                    android:id="@+id/titleBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:fitStatusBar="true"
                    app:navigationIconColor="@color/text_inverse"
                    app:navigationMarginStart="@dimen/dp_0" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_savings_playbook_gradient"
                android:orientation="vertical"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_16">

                <com.velora.portal.platform.design.component.SurfacePanelLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:panelCornerRadius="@dimen/dp_12"
                    app:panelFillColor="@color/surface_primary">

                    <LinearLayout
                        android:layout_width="0dp"
                         android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/dp_12"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.velora.portal.platform.design.component.StatefulLabelView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_36"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/calculator_savings_tip_updated"
                            android:textColor="@color/text_inverse"
                            android:textSize="@dimen/sp_14"
                            android:textStyle="bold"
                            app:labelCornerRadius="@dimen/dp_18"
                            app:labelFillColor="@color/brand_secondary" />

                        <TextView
                            android:id="@+id/tvStartPlanTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_10"
                            android:drawableStart="@drawable/ic_savings_tip_bullet"
                            android:drawablePadding="@dimen/dp_6"
                            android:gravity="center_vertical"
                            android:text="@string/calculator_savings_tip_start_title"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:lineSpacingExtra="@dimen/dp_2"
                            android:text="@string/calculator_savings_tip_start_description"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/sp_11" />

                        <TextView
                            android:id="@+id/tvSaveFirstTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_12"
                            android:drawableStart="@drawable/ic_savings_tip_bullet"
                            android:drawablePadding="@dimen/dp_6"
                            android:gravity="center_vertical"
                            android:text="@string/calculator_savings_tip_save_first_title"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:lineSpacingExtra="@dimen/dp_2"
                            android:text="@string/calculator_savings_tip_save_first_description"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/sp_11" />

                        <TextView
                            android:id="@+id/tvReduceExpensesTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_12"
                            android:drawableStart="@drawable/ic_savings_tip_bullet"
                            android:drawablePadding="@dimen/dp_6"
                            android:gravity="center_vertical"
                            android:text="@string/calculator_savings_tip_reduce_title"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:lineSpacingExtra="@dimen/dp_2"
                            android:text="@string/calculator_savings_tip_reduce_description"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/sp_11" />

                        <TextView
                            android:id="@+id/tvSavingsGoalTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_12"
                            android:drawableStart="@drawable/ic_savings_tip_bullet"
                            android:drawablePadding="@dimen/dp_6"
                            android:gravity="center_vertical"
                            android:text="@string/calculator_savings_tip_goal_title"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:lineSpacingExtra="@dimen/dp_2"
                            android:text="@string/calculator_savings_tip_goal_description"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/sp_11" />
                    </LinearLayout>
                </com.velora.portal.platform.design.component.SurfacePanelLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/dp_12"
                android:background="@color/surface_primary"
                android:minHeight="@dimen/dp_112"
                android:orientation="vertical"
                android:paddingStart="@dimen/dp_16"
                android:paddingTop="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_24"
                android:layout_weight="1">

                <include
                    android:id="@+id/quickTools"
                    layout="@layout/view_moneyflow_quick_tools"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
