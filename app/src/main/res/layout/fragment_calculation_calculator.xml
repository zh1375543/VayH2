<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_14"
        android:paddingTop="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_30"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.velora.portal.core.ui.component.StyledConstraintLayout
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                app:radius="@dimen/dp_4"
                app:solidColor="@color/surface_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:includeFontPadding="false"
                android:text="@string/calculator_title"
                android:textColor="@color/brand_primary"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />
        </LinearLayout>

        <include
            android:id="@+id/menuSalary"
            layout="@layout/item_calculator_menu"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_72"
            android:layout_marginTop="@dimen/dp_10" />

        <include
            android:id="@+id/menuOvertime"
            layout="@layout/item_calculator_menu"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_72"
            android:layout_marginTop="@dimen/dp_10" />

        <include
            android:id="@+id/menuWorkHour"
            layout="@layout/item_calculator_menu"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_72"
            android:layout_marginTop="@dimen/dp_10" />

        <include
            android:id="@+id/menuTax"
            layout="@layout/item_calculator_menu"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_72"
            android:layout_marginTop="@dimen/dp_10" />

        <include
            android:id="@+id/menuBonus"
            layout="@layout/item_calculator_menu"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_72"
            android:layout_marginTop="@dimen/dp_10" />

        <include
            android:id="@+id/menuSavings"
            layout="@layout/item_calculator_menu"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_72"
            android:layout_marginTop="@dimen/dp_10" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
