<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg_color1">

    <com.velora.portal.platform.design.component.PageHeaderView
        android:id="@+id/payoutContactHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        app:centerText="@string/bank_and_contact"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/page_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp_15"
        android:paddingTop="@dimen/dp_10"
        app:layout_constraintBottom_toTopOf="@id/submissionActionBar"
        app:layout_constraintTop_toBottomOf="@id/payoutContactHeader">

        <FrameLayout
            android:id="@+id/page_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/payoutContactScroll"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/dp_24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/payoutMethodSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <include
                        android:id="@+id/disbursementForm"
                        layout="@layout/view_disbursement_account_form" />
                </LinearLayout>

                <com.velora.portal.platform.design.component.StyledLinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:orientation="vertical"
                    app:radius="@dimen/dp_12"
                    app:solidColor="@color/text_inverse">

                    <com.velora.portal.platform.design.component.StatefulLabelView
                        style="@style/TypeTag"
                        android:text="@string/emergency_contact" />
                    <TextView
                        android:id="@+id/tvContactGuidance"
                        android:layout_width="match_parent"
                        android:layout_marginHorizontal="@dimen/dp_16"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_10"
                        android:text="@string/contact_tips"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/sp_12"
                        android:visibility="gone"
                        tools:visibility="visible" />
                <!-- Relationship 1 -->
                <com.velora.portal.platform.design.component.FormItemView
                    android:id="@+id/primaryRelationshipField"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_height="wrap_content"
                    app:errorText="@string/please_choose_current_info"
                    app:formType="select"
                    app:hintText="@string/please_choose"
                    app:titleText="@string/contact_people1" />

                <!-- Contact name -->
                <com.velora.portal.platform.design.component.FormItemView
                    android:id="@+id/primaryContactNameField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:errorText="@string/please_enter_contact_name"
                    app:formType="input"
                    app:hintText="@string/please_enter_contact_name"
                    app:inputType="text"
                    app:titleText="@string/contact_name" />

                <!-- Contact phone -->
                <com.velora.portal.platform.design.component.FormItemView
                    android:id="@+id/primaryContactPhoneField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:editMaxLength="40"
                    app:errorText="@string/please_enter_phone_number"
                    app:formType="input"
                    app:hintText="@string/please_enter_phone_number"
                    app:inputType="phone"
                    app:titleText="@string/contact_phone_number" />

                <com.velora.portal.platform.design.component.FormItemView
                    android:id="@+id/secondaryRelationshipField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:errorText="@string/please_choose_current_info"
                    app:formType="select"
                    app:hintText="@string/please_choose"
                    app:titleText="@string/contact_people2" />

                <com.velora.portal.platform.design.component.FormItemView
                    android:id="@+id/secondaryContactNameField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:errorText="@string/please_enter_contact_name"
                    app:formType="input"
                    app:hintText="@string/please_enter_contact_name"
                    app:inputType="text"
                    app:titleText="@string/contact_name" />

                <com.velora.portal.platform.design.component.FormItemView
                    android:id="@+id/secondaryContactPhoneField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:editMaxLength="40"
                    app:errorText="@string/please_enter_phone_number"
                    app:formType="input"
                    app:hintText="@string/please_enter_phone_number"
                    app:inputType="phone"
                    app:titleText="@string/contact_phone_number" />

                <LinearLayout
                    android:id="@+id/additionalContactSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.velora.portal.platform.design.component.FormItemView
                        android:id="@+id/additionalRelationshipField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:errorText="@string/please_choose_current_info"
                        app:formType="select"
                        app:hintText="@string/please_choose"
                        app:titleText="@string/contact_people3" />

                    <com.velora.portal.platform.design.component.FormItemView
                        android:id="@+id/additionalContactNameField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:errorText="@string/please_enter_contact_name"
                        app:formType="input"
                        app:hintText="@string/please_enter_contact_name"
                        app:inputType="text"
                        app:titleText="@string/contact_name" />

                    <com.velora.portal.platform.design.component.FormItemView
                        android:id="@+id/additionalContactPhoneField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:editMaxLength="40"
                        app:errorText="@string/please_enter_phone_number"
                        app:formType="input"
                        app:hintText="@string/please_enter_phone_number"
                        app:inputType="phone"
                        app:titleText="@string/contact_phone_number" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_18" />
                </com.velora.portal.platform.design.component.StyledLinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </FrameLayout>

        <com.velora.portal.platform.design.component.PageStateOverlayView
            android:id="@+id/pageState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/submissionActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_15"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="visible">

        <com.velora.portal.platform.design.component.StatefulLabelView
            style="@style/AuthDataEncryptedTipText"
            android:layout_gravity="center_horizontal"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_10" />

        <com.velora.portal.platform.design.component.StatefulActionButton
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:text="@string/next"
            app:actionButtonVariant="filled" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
