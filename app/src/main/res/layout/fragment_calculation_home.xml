<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_14"
        android:paddingTop="@dimen/dp_14"
        android:paddingEnd="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_24">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_30">

            <com.velora.portal.platform.design.component.SurfacePanelLayout
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:panelCornerRadius="@dimen/dp_4"
                app:panelFillColor="@color/surface_muted" />

            <TextView
                android:id="@+id/tvGreetingTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/calculator_greeting_title"
                android:textColor="@color/brand_primary"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/ivMessage"
                app:layout_constraintStart_toEndOf="@id/tvGreetingTitlePlaceholder"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/tvGreetingTitlePlaceholder"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvGreetingDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/calculator_greeting_guest"
                android:textColor="@color/text_body"
                android:textSize="@dimen/sp_10"
                app:layout_constraintEnd_toStartOf="@id/ivMessage"
                app:layout_constraintStart_toEndOf="@id/tvGreetingTitlePlaceholder"
                app:layout_constraintTop_toBottomOf="@id/tvGreetingTitle" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivMessage"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:contentDescription="@null"
                android:scaleType="centerInside"
                android:src="@mipmap/page_message_ic"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:id="@+id/layoutEarnings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_118"
            android:layout_marginTop="@dimen/dp_12">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivEarningsBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@mipmap/ic_main_card_bg" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutGuestEarnings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/dp_10"
                android:paddingTop="@dimen/dp_26"
                android:paddingEnd="@dimen/dp_14"
                android:paddingBottom="@dimen/dp_14">

                <TextView
                    android:id="@+id/tvGuestEarningsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/calculator_setup_salary"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/sp_20"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvGuestEarningsDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/calculator_start_calculating"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/sp_12"
                    app:layout_constraintEnd_toStartOf="@id/tvHeroAction"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvGuestEarningsTitle" />

                <com.velora.portal.platform.design.component.StatefulLabelView
                    android:id="@+id/tvHeroAction"
                    android:layout_width="@dimen/dp_92"
                    android:layout_height="@dimen/dp_32"
                    android:gravity="center"
                    android:text="@string/calculator_setup"
                    android:textColor="@color/brand_primary"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:labelCornerRadius="@dimen/dp_6"
                    app:labelFillColor="@color/surface_primary" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutMemberEarnings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/dp_10"
                android:paddingTop="@dimen/dp_26"
                android:paddingEnd="@dimen/dp_14"
                android:paddingBottom="@dimen/dp_14"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvMemberEarningsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/calculator_today_earnings"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvMemberEarningsValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/calculator_empty_currency"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/sp_28"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvMemberEarningsTitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/cardMonthlySalary"
                layout="@layout/item_calculation_stat_card"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_116"
                android:layout_weight="1" />

            <include
                android:id="@+id/cardNextPayday"
                layout="@layout/item_calculation_stat_card"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_116"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/cardDailySalary"
                layout="@layout/item_calculation_stat_card"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_116"
                android:layout_weight="1" />

            <include
                android:id="@+id/cardMonthlyGoal"
                layout="@layout/item_calculation_stat_card"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_116"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_weight="1" />
        </LinearLayout>

        <include
            android:id="@+id/quickTools"
            layout="@layout/view_calculation_quick_tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_14" />
    </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.velora.portal.platform.design.component.PageStateOverlayView
        android:id="@+id/pageState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />
</FrameLayout>
