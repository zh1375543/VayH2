<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/contentLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/repayment_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.velora.portal.platform.design.component.CurvedHeaderLayout
                    android:id="@+id/repaymentHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:curvedHeaderArcDepth="@dimen/dp_36"
                    app:curvedHeaderContentSpacing="@dimen/dp_10"
                    app:curvedHeaderFillColor="@color/brand_primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/repaymentContent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.velora.portal.platform.design.component.StatefulLabelView
                            android:id="@+id/tvRepaymentTip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/dp_16"
                            android:layout_marginTop="@dimen/dp_16"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/dp_16"
                            android:paddingVertical="@dimen/dp_12"
                            android:text="@string/batch_repayment_tips"
                            android:textColor="@color/text_inverse"
                            android:textSize="@dimen/sp_11"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:labelCornerRadius="@dimen/dp_20"
                            app:labelFillColor="@color/p40_FFFFFF" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivRepayment"
                            android:layout_width="@dimen/dp_80"
                            android:layout_height="@dimen/dp_80"
                            android:contentDescription="@null"
                            android:src="@mipmap/ic_loan_show"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvRepaymentTip" />

                        <TextView
                            android:id="@+id/tvOrderNum"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/dp_20"
                            android:layout_marginBottom="@dimen/dp_16"
                            android:gravity="center"
                            android:text="@string/home_order_num"
                            android:textColor="@color/text_inverse"
                            android:textSize="@dimen/sp_14"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/ivRepayment" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    </com.velora.portal.platform.design.component.CurvedHeaderLayout>

                    <com.velora.portal.platform.design.component.StatefulActionButton
                        android:id="@+id/tvRepayment"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_48"
                        android:elevation="@dimen/dp_4"
                        android:layout_marginHorizontal="@dimen/dp_48"
                        android:layout_marginTop="@dimen/dp_m_30"
                        android:layout_marginBottom="@dimen/dp_10"
                        android:paddingHorizontal="@dimen/dp_22"
                        android:text="@string/batch_repayment"
                        android:textSize="@dimen/sp_18"
                        android:textStyle="bold"
                        app:buttonSolidColor="@color/brand_secondary"
                        app:buttonTextColor="@color/text_inverse"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/repaymentHeader" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/order_layout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:visibility="visible"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_marginBottom="@dimen/dp_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/repayment_layout">

                    <androidx.core.widget.NestedScrollView
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:clipToPadding="false"
                        android:fillViewport="false"
                        android:overScrollMode="never"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="@dimen/dp_10">

                            <TextView
                                android:id="@+id/tvOrders"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_10"
                                android:text="@string/orders"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/sp_18"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <com.velora.portal.platform.design.component.StyledRecyclerView
                                android:id="@+id/rvOrder"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_10"
                                android:nestedScrollingEnabled="false"
                                android:orientation="vertical"
                                android:overScrollMode="never"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tvOrders"
                                tools:itemCount="1"
                                tools:listitem="@layout/item_home_borrowing"
                                tools:visibility="visible" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.core.widget.NestedScrollView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/emptyOrder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingBottom="@dimen/dp_24"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.velora.portal.platform.design.component.CurvedHeaderLayout
                        android:id="@+id/emptyOrderBg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:curvedHeaderArcDepth="@dimen/dp_36"
                        app:curvedHeaderContentSpacing="@dimen/dp_0"
                        app:curvedHeaderFillColor="@color/brand_primary">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivEmptyOrder"
                            android:layout_width="@dimen/dp_70"
                            android:layout_height="@dimen/dp_70"
                            android:layout_marginTop="@dimen/dp_30"
                            android:src="@mipmap/ic_loan_null"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_content"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_12"
                            android:layout_marginBottom="@dimen/dp_30"
                            android:gravity="center"
                            android:text="@string/empty_home_order"
                            android:textColor="@color/text_inverse"
                            android:textSize="@dimen/sp_14"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/ivEmptyOrder"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </com.velora.portal.platform.design.component.CurvedHeaderLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/benefitsLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/dp_16"
                        android:layout_marginTop="@dimen/dp_20">

                        <TextView
                            android:id="@+id/tvBenefits"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/benefits_of_paying"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/sp_16"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.velora.portal.platform.design.component.SurfacePanelLayout
                            android:id="@+id/benefitsContent"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_16"
                            android:paddingHorizontal="@dimen/dp_16"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvBenefits"
                            app:panelCornerRadius="@dimen/dp_16"
                            app:panelFillColor="@color/surface_primary">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivTip1"
                                android:layout_width="@dimen/dp_60"
                                android:layout_height="@dimen/dp_60"
                                android:src="@mipmap/ic_order_score"
                                app:layout_constraintBottom_toBottomOf="@id/tip_layout1"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="@id/tip_layout1" />

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/tip_layout1"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp_80"
                                android:layout_marginStart="@dimen/dp_12"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/ivTip1"
                                app:layout_constraintTop_toTopOf="parent">

                                <TextView
                                    android:id="@+id/tvTitle1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_order_title1"
                                    android:textColor="@color/text_primary"
                                    android:textSize="@dimen/sp_14"
                                    android:textStyle="bold"
                                    app:layout_constraintBottom_toTopOf="@id/tvDesc1"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintVertical_chainStyle="packed" />

                                <TextView
                                    android:id="@+id/tvDesc1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/dp_2"
                                    android:lineSpacingExtra="@dimen/dp_1"
                                    android:text="@string/home_order_desc1"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/sp_12"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/tvTitle1" />
                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivTip2"
                                android:layout_width="@dimen/dp_60"
                                android:layout_height="@dimen/dp_60"
                                android:src="@mipmap/ic_order_increase"
                                app:layout_constraintBottom_toBottomOf="@id/tip_layout2"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="@id/tip_layout2" />

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/tip_layout2"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp_80"
                                android:layout_marginStart="@dimen/dp_12"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/ivTip2"
                                app:layout_constraintTop_toBottomOf="@id/tip_layout1">

                                <TextView
                                    android:id="@+id/tvTitle2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_order_title2"
                                    android:textColor="@color/text_primary"
                                    android:textSize="@dimen/sp_14"
                                    android:textStyle="bold"
                                    app:layout_constraintBottom_toTopOf="@id/tvDesc2"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintVertical_chainStyle="packed" />

                                <TextView
                                    android:id="@+id/tvDesc2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/dp_2"
                                    android:lineSpacingExtra="@dimen/dp_1"
                                    android:text="@string/home_order_desc2"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/sp_12"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/tvTitle2" />
                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivTip3"
                                android:layout_width="@dimen/dp_60"
                                android:layout_height="@dimen/dp_60"
                                android:src="@mipmap/ic_order_improve"
                                app:layout_constraintBottom_toBottomOf="@id/tip_layout3"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="@id/tip_layout3" />

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/tip_layout3"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp_80"
                                android:layout_marginStart="@dimen/dp_12"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/ivTip3"
                                app:layout_constraintTop_toBottomOf="@id/tip_layout2">

                                <TextView
                                    android:id="@+id/tvTitle3"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_order_title3"
                                    android:textColor="@color/text_primary"
                                    android:textSize="@dimen/sp_14"
                                    android:textStyle="bold"
                                    app:layout_constraintBottom_toTopOf="@id/tvDesc3"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintVertical_chainStyle="packed" />

                                <TextView
                                    android:id="@+id/tvDesc3"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/dp_2"
                                    android:lineSpacingExtra="@dimen/dp_1"
                                    android:text="@string/home_order_desc3"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/sp_12"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/tvTitle3" />
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </com.velora.portal.platform.design.component.SurfacePanelLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.velora.portal.platform.design.component.PageStateOverlayView
                android:id="@+id/pageState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</FrameLayout>
