<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvPlanSectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:text="@string/choose_repayment_plan"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/ivExpandPlans"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivExpandPlans"
        android:layout_width="@dimen/dp_28"
        android:layout_height="@dimen/dp_28"
        android:padding="@dimen/dp_4"
        android:src="@mipmap/product_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/tvPlanSectionTitle"
        app:layout_constraintTop_toTopOf="@id/tvPlanSectionTitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTermOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:orientation="horizontal"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/tvPlanSectionTitle"
        tools:listitem="@layout/item_repayment_option" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/termOptionsGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvPlanSectionTitle,ivExpandPlans,rvTermOptions" />

    <TextView
        android:id="@+id/tvScheduleSectionTitle"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_28"
        android:layout_marginTop="@dimen/dp_20"
        android:gravity="center_vertical"
        android:text="@string/installment_details"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/ivExpandSchedule"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rvTermOptions" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivExpandSchedule"
        android:layout_width="@dimen/dp_28"
        android:layout_height="@dimen/dp_28"
        android:padding="@dimen/dp_4"
        android:src="@mipmap/product_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvScheduleSectionTitle" />

    <com.velora.portal.core.ui.component.StyledTextView
        android:id="@+id/scheduleBg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_m_8"
        app:layout_constraintBottom_toBottomOf="@id/rvInstallmentSchedule"
        app:layout_constraintTop_toTopOf="@id/tvDueDateTitle"
        app:radius="@dimen/dp_16"
        app:solidColor="@color/surface_secondary" />

    <TextView
        android:id="@+id/tvDueDateTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_18"
        android:paddingStart="@dimen/dp_10"
        android:text="@string/due_date"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/sp_13"
        app:layout_constraintEnd_toStartOf="@id/tvRepaymentAmountTitle"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvScheduleSectionTitle" />

    <TextView
        android:id="@+id/tvRepaymentAmountTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingEnd="@dimen/dp_10"
        android:text="@string/repayment_amount"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/sp_13"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="3"
        app:layout_constraintStart_toEndOf="@id/tvDueDateTitle"
        app:layout_constraintTop_toTopOf="@id/tvDueDateTitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvInstallmentSchedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDueDateTitle"
        tools:itemCount="3"
        tools:listitem="@layout/item_installment_schedule" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/scheduleGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:constraint_referenced_ids="tvDueDateTitle,tvRepaymentAmountTitle,rvInstallmentSchedule,scheduleBg" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/scheduleHeaderGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvScheduleSectionTitle,ivExpandSchedule" />

</androidx.constraintlayout.widget.ConstraintLayout>
