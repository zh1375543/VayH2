<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_page_bg">

    <com.velora.portal.platform.design.component.PageHeaderView
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_primary"
        app:centerText="@string/loan_application"
        app:tintColor="@color/text_inverse"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/tvPrivacy"
        app:layout_constraintTop_toBottomOf="@id/titleBar">

        <com.velora.portal.platform.design.component.CurvedHeaderLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:curvedHeaderArcDepth="@dimen/dp_36"
            app:curvedHeaderContentSpacing="@dimen/dp_20"
            app:curvedHeaderFillColor="@color/brand_primary">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_108"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_loan_header"
                android:translationX="@dimen/dp_26"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </com.velora.portal.platform.design.component.CurvedHeaderLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_100"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/dp_16">

                <include
                    android:id="@+id/loanSummaryDetails"
                    layout="@layout/view_loan_product_summary_details"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_12"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.velora.portal.platform.design.component.SurfacePanelLayout
                    android:id="@+id/repaymentPlanCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_12"
                    android:paddingHorizontal="@dimen/dp_16"
                    android:paddingTop="@dimen/dp_20"
                    android:paddingBottom="@dimen/dp_20"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/loanSummaryDetails"
                    app:panelCornerRadius="@dimen/dp_12"
                    app:panelFillColor="@color/surface_primary">

                    <com.velora.portal.journey.lending.catalog.presentation.component.RepaymentPlanView
                        android:id="@+id/repaymentPlanView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </com.velora.portal.platform.design.component.SurfacePanelLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <com.velora.portal.platform.design.component.PageStateOverlayView
            android:id="@+id/pageState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvPrivacy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_12"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/dp_4"
        android:paddingHorizontal="@dimen/dp_36"
        android:paddingTop="@dimen/dp_15"
        android:paddingBottom="@dimen/dp_6"
        android:text="@string/product_detail_agreement"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/sp_13"
        app:layout_constraintBottom_toTopOf="@id/bottomCard"
        app:layout_goneMarginBottom="@dimen/dp_30" />

    <com.velora.portal.platform.design.component.SurfacePanelLayout
        android:id="@+id/bottomCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_10"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingTop="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:panelFillColor="@color/surface_primary">

        <TextView
            android:id="@+id/tvAccountTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/account_receivable"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/sp_14"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/accountInfoLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_8"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/tvAccountTitle"
            app:layout_constraintEnd_toStartOf="@id/btnSwitchAccount"
            app:layout_constraintTop_toTopOf="@id/tvAccountTitle">

            <TextView
                android:id="@+id/tvAccountType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                tools:text="card" />

            <TextView
                android:id="@+id/tvCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                tools:text="111111" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <com.velora.portal.platform.design.component.StatefulLabelView
            android:id="@+id/btnSwitchAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dp_12"
            android:paddingVertical="@dimen/dp_8"
            android:text="@string/change"
            android:textColor="@color/text_inverse"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toBottomOf="@id/tvAccountTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvAccountTitle"
            app:labelCornerRadius="@dimen/dp_12"
            app:labelFillColor="@color/brand_secondary" />

        <com.velora.portal.platform.design.component.SurfacePanelLayout
            android:id="@+id/walletTipPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:padding="@dimen/dp_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAccountTitle"
            app:panelCornerRadius="@dimen/dp_12"
            app:panelFillColor="@color/color_page_bg">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivLoanTip"
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:src="@mipmap/icon_image_tips"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvLoanTip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:lineSpacingExtra="@dimen/dp_2"
                android:text="@string/loan_account_tip"
                android:textColor="@color/action_withdraw"
                android:textSize="@dimen/sp_12"
                app:layout_constraintBottom_toBottomOf="@id/ivLoanTip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivLoanTip"
                app:layout_constraintTop_toTopOf="@id/ivLoanTip" />
        </com.velora.portal.platform.design.component.SurfacePanelLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/repaymentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/dp_10"
            app:layout_goneMarginTop="@dimen/dp_15"
            app:layout_constraintTop_toBottomOf="@id/walletTipPanel">


            <com.velora.portal.platform.design.component.StatefulActionButton
                android:id="@+id/btnWithdraw"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/withdrawal"
                android:textSize="@dimen/sp_18"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvLoanTip"
                tools:ignore="NotSibling" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.velora.portal.platform.design.component.SurfacePanelLayout>

    <androidx.constraintlayout.widget.Group
        android:id="@+id/bottomUiGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvPrivacy,bottomCard"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>
