<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg_color1">

    <com.novexa.platform.core.ui.component.PageHeaderView
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:centerText="@string/loan_application"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/tvPrivacy"
        app:layout_constraintTop_toBottomOf="@id/titleBar">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/dp_16">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/productSummaryCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_12"
                    android:background="@mipmap/ic_main_card_bg"
                    android:paddingStart="@dimen/dp_20"
                    android:paddingTop="@dimen/dp_16"
                    android:paddingEnd="@dimen/dp_20"
                    android:paddingBottom="@dimen/dp_12"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvLoanAmount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/home_product_loan_amount_title"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/sp_18"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvAmount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/sp_24"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvLoanAmount"
                        tools:text="200,000,000đ" />

                    <com.novexa.platform.core.ui.component.StyledTextView
                        android:id="@+id/tvLeaseInfo"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_48"
                        android:layout_marginTop="@dimen/dp_12"
                        android:drawableEnd="@mipmap/mine_right"
                        android:drawablePadding="@dimen/dp_8"
                        android:drawableTint="@color/text_inverse"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/dp_16"
                        android:paddingEnd="@dimen/dp_12"
                        android:text="@string/about_lease"
                        android:textColor="@color/text_inverse"
                        android:textSize="@dimen/sp_15"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvAmount"
                        app:radius="@dimen/dp_12"
                        app:solidColor="@color/p40_FFFFFF" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.novexa.platform.core.ui.component.StyledConstraintLayout
                    android:id="@+id/productDetailsCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_12"
                    android:paddingHorizontal="@dimen/dp_16"
                    android:paddingTop="@dimen/dp_20"
                    android:paddingBottom="@dimen/dp_20"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/productSummaryCard"
                    app:radius="@dimen/dp_24"
                    app:solidColor="@color/surface_primary">

                    <com.novexa.platform.feature.catalog.presentation.component.LoanProductDetailsView
                        android:id="@+id/productDetailsView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </com.novexa.platform.core.ui.component.StyledConstraintLayout>

                <com.novexa.platform.core.ui.component.StyledConstraintLayout
                    android:id="@+id/repaymentPlanCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_12"
                    android:paddingHorizontal="@dimen/dp_16"
                    android:paddingTop="@dimen/dp_20"
                    android:paddingBottom="@dimen/dp_20"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/productDetailsCard"
                    app:radius="@dimen/dp_24"
                    app:solidColor="@color/surface_primary">

                    <com.novexa.platform.feature.catalog.presentation.component.RepaymentPlanView
                        android:id="@+id/repaymentPlanView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </com.novexa.platform.core.ui.component.StyledConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <com.novexa.platform.core.ui.component.PageStateOverlayView
            android:id="@+id/pageState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvPrivacy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_12"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/dp_4"
        android:paddingHorizontal="@dimen/dp_36"
        android:paddingTop="@dimen/dp_15"
        android:paddingBottom="@dimen/dp_6"
        android:text="@string/product_detail_agreement"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/sp_13"
        app:layout_constraintBottom_toTopOf="@id/bottomCard"
        app:layout_goneMarginBottom="@dimen/dp_30" />

    <com.novexa.platform.core.ui.component.StyledConstraintLayout
        android:id="@+id/bottomCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_10"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingTop="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:solidColor="@color/surface_primary">

        <TextView
            android:id="@+id/tvAccountTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/account_receivable"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/sp_14"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/accountInfoLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_8"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/tvAccountTitle"
            app:layout_constraintEnd_toStartOf="@id/btnSwitchAccount"
            app:layout_constraintTop_toTopOf="@id/tvAccountTitle">

            <TextView
                android:id="@+id/tvAccountType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                tools:text="card" />

            <TextView
                android:id="@+id/tvCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                tools:text="111111" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <com.novexa.platform.core.ui.component.StyledTextView
            android:id="@+id/btnSwitchAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dp_12"
            android:paddingVertical="@dimen/dp_8"
            android:text="@string/change"
            android:textColor="@color/text_inverse"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toBottomOf="@id/tvAccountTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvAccountTitle"
            app:radius="@dimen/dp_15"
            app:solidColor="@color/brand_primary" />

        <com.novexa.platform.core.ui.component.StyledConstraintLayout
            android:id="@+id/walletTipPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:padding="@dimen/dp_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAccountTitle"
            app:radius="@dimen/dp_16"
            app:solidColor="@color/color_verify_tip">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivLoanTip"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:src="@mipmap/ic_loan_tip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvLoanTip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:lineSpacingExtra="@dimen/dp_2"
                android:text="@string/loan_account_tip"
                android:textColor="@color/action_withdraw"
                android:textSize="@dimen/sp_12"
                app:layout_constraintBottom_toBottomOf="@id/ivLoanTip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivLoanTip"
                app:layout_constraintTop_toTopOf="@id/ivLoanTip" />
        </com.novexa.platform.core.ui.component.StyledConstraintLayout>

        <com.novexa.platform.core.ui.component.StyledConstraintLayout
            android:id="@+id/repaymentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/dp_10"
            app:layout_goneMarginTop="@dimen/dp_15"
            app:layout_constraintTop_toBottomOf="@id/walletTipPanel">


            <com.novexa.platform.core.ui.component.StatefulActionButton
                android:id="@+id/btnWithdraw"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/withdrawal"
                android:textSize="@dimen/sp_18"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvLoanTip" />
        </com.novexa.platform.core.ui.component.StyledConstraintLayout>
    </com.novexa.platform.core.ui.component.StyledConstraintLayout>

    <androidx.constraintlayout.widget.Group
        android:id="@+id/bottomUiGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvPrivacy,bottomCard"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>
