<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_14"
        android:paddingTop="@dimen/dp_14"
        android:paddingEnd="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_36"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.novexa.platform.core.ui.component.StyledConstraintLayout
                android:layout_width="@dimen/dp_28"
                android:layout_height="@dimen/dp_28"
                app:radius="@dimen/dp_4"
                app:solidColor="@color/surface_muted" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/calculator_tips_title"
                    android:textColor="@color/brand_primary"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/calculator_tips_description"
                    android:textColor="@color/text_body"
                    android:textSize="@dimen/sp_10" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/cardSalaryTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_14">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@mipmap/page_sava_bg" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_118"
                android:paddingStart="@dimen/dp_12"
                android:paddingTop="@dimen/dp_17"
                android:paddingEnd="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_10">

                <TextView
                    android:id="@+id/tvSalaryTipTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/calculator_tips_salary_title"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSalaryTipDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:lineSpacingExtra="@dimen/dp_2"
                    android:text="@string/calculator_tips_salary_description"
                    android:textColor="@color/p40_FFFFFF"
                    android:textSize="@dimen/sp_13"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSalaryTipTitle" />

                <TextView
                    android:id="@+id/tvSalaryTipReadMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calculator_tips_read_more"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSalaryTipDescription"
                    app:layout_constraintVertical_bias="1" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/cardBudgetTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@mipmap/page_rule_bg" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_118"
                android:paddingStart="@dimen/dp_12"
                android:paddingTop="@dimen/dp_17"
                android:paddingEnd="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_10">

                <TextView
                    android:id="@+id/tvBudgetTipTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/calculator_tips_budget_title"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvBudgetTipDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/calculator_tips_budget_description"
                    android:textColor="@color/p40_FFFFFF"
                    android:textSize="@dimen/sp_13"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvBudgetTipTitle" />

                <TextView
                    android:id="@+id/tvBudgetTipReadMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calculator_tips_read_more"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvBudgetTipDescription"
                    app:layout_constraintVertical_bias="1" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/cardExpensesTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@mipmap/page_track_bg" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_118"
                android:paddingStart="@dimen/dp_12"
                android:paddingTop="@dimen/dp_17"
                android:paddingEnd="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_10">

                <TextView
                    android:id="@+id/tvExpensesTipTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/calculator_tips_expenses_title"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvExpensesTipDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:lineSpacingExtra="@dimen/dp_2"
                    android:text="@string/calculator_tips_expenses_description"
                    android:textColor="@color/p40_FFFFFF"
                    android:textSize="@dimen/sp_13"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvExpensesTipTitle" />

                <TextView
                    android:id="@+id/tvExpensesTipReadMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calculator_tips_read_more"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvExpensesTipDescription"
                    app:layout_constraintVertical_bias="1" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/cardGoalTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@mipmap/page_goal_bg" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_118"
                android:paddingStart="@dimen/dp_12"
                android:paddingTop="@dimen/dp_17"
                android:paddingEnd="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_10">

                <TextView
                    android:id="@+id/tvGoalTipTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/calculator_tips_goal_title"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvGoalTipDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/calculator_tips_goal_description"
                    android:textColor="@color/p40_FFFFFF"
                    android:textSize="@dimen/sp_13"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvGoalTipTitle" />

                <TextView
                    android:id="@+id/tvGoalTipReadMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calculator_tips_read_more"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvGoalTipDescription"
                    app:layout_constraintVertical_bias="1" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
