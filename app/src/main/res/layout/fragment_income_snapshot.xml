<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/dp_24">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutEarnings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.velora.portal.platform.design.component.CurvedHeaderLayout
                android:id="@+id/layoutEarningsHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:curvedHeaderArcDepth="@dimen/dp_36"
                app:curvedHeaderContentSpacing="@dimen/dp_20"
                app:curvedHeaderFillColor="@color/brand_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvGreetingTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_12"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/calculator_greeting_title"
                    android:textColor="@color/brand_secondary"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/ivMessage"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvGreetingDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_16"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/calculator_greeting_guest"
                    android:textColor="@color/text_body"
                    android:textSize="@dimen/sp_10"
                    app:layout_constraintEnd_toStartOf="@id/ivMessage"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvGreetingTitle" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivMessage"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginEnd="@dimen/dp_14"
                    android:contentDescription="@null"
                    android:scaleType="centerInside"
                    android:src="@mipmap/page_message_ic"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivEarningsIllustration"
                    android:layout_width="@dimen/dp_92"
                    android:layout_height="@dimen/dp_92"
                    android:layout_marginTop="@dimen/dp_46"
                    android:layout_marginEnd="@dimen/dp_14"
                    android:contentDescription="@null"
                    android:scaleType="centerInside"
                    android:src="@mipmap/image_login_top"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutGuestEarnings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_56"
                android:paddingStart="@dimen/dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvGuestEarningsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/calculator_setup_salary"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/sp_24"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvGuestEarningsDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/calculator_start_calculating"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/sp_14"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvGuestEarningsTitle" />

                <com.velora.portal.platform.design.component.StatefulLabelView
                    android:id="@+id/tvHeroAction"
                    android:layout_width="@dimen/dp_92"
                    android:layout_height="@dimen/dp_32"
                    android:gravity="center"
                    android:text="@string/calculator_setup"
                    android:textColor="@color/brand_primary"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/dp_8"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvGuestEarningsDescription"
                    app:labelCornerRadius="@dimen/dp_6"
                    app:labelFillColor="@color/surface_primary" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutMemberEarnings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_56"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_130"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvMemberEarningsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/calculator_today_earnings"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvMemberEarningsValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/calculator_empty_currency"
                    android:textColor="@color/text_inverse"
                    android:textSize="@dimen/sp_28"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvMemberEarningsTitle" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.velora.portal.platform.design.component.CurvedHeaderLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_m_20"
                android:orientation="vertical"
                android:paddingStart="@dimen/dp_14"
                android:paddingEnd="@dimen/dp_14"
                android:paddingBottom="@dimen/dp_14"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutEarningsHeader">

                <include
                    android:id="@+id/cardMonthlySalary"
                    layout="@layout/item_income_stat_card"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_64" />

                <include
                    android:id="@+id/cardNextPayday"
                    layout="@layout/item_income_stat_card"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_64"
                    android:layout_marginTop="@dimen/dp_8" />

                <include
                    android:id="@+id/cardDailySalary"
                    layout="@layout/item_income_stat_card"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_64"
                    android:layout_marginTop="@dimen/dp_8" />

                <include
                    android:id="@+id/cardMonthlyGoal"
                    layout="@layout/item_income_stat_card"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_64"
                    android:layout_marginTop="@dimen/dp_8" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <include
            android:id="@+id/quickTools"
            layout="@layout/view_moneyflow_quick_tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_14"
            android:layout_marginTop="@dimen/dp_14"
            android:layout_marginEnd="@dimen/dp_14" />
    </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.velora.portal.platform.design.component.PageStateOverlayView
        android:id="@+id/pageState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />
</FrameLayout>
