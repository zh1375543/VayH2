<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg_color1">

    <com.velora.portal.core.ui.component.PageHeaderView
        android:id="@+id/titleBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_56"
        app:centerText="@string/calculator_tax_title"
        app:fitStatusBar="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/taxInputScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/dp_16"
        android:paddingTop="@dimen/dp_4"
        android:paddingEnd="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@id/tvCalculate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleBar">

        <com.velora.portal.core.ui.component.StyledConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/dp_8"
            app:radius="@dimen/dp_12"
            app:solidColor="@color/surface_primary"
            app:strokeColor="@color/brand_primary"
            app:strokeWidth="@dimen/dp_1">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.velora.portal.core.ui.component.FormItemView
                    android:id="@+id/incomePeriodView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:formType="select"
                    app:hintText="@string/please_select"
                    app:inputBackgroundColor="@color/surface_primary"
                    app:inputFocusedStrokeColor="@color/brand_primary"
                    app:inputStrokeColor="@color/border_default"
                    app:titleText="@string/calculator_income_period" />

                <com.velora.portal.core.ui.component.FormItemView
                    android:id="@+id/grossIncomeView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:formType="input"
                    app:hintText="@string/please_enter"
                    app:inputBackgroundColor="@color/surface_primary"
                    app:inputFocusedStrokeColor="@color/brand_primary"
                    app:inputStrokeColor="@color/border_default"
                    app:inputType="number"
                    app:titleText="@string/calculator_gross_income" />

                <com.velora.portal.core.ui.component.FormItemView
                    android:id="@+id/additionalIncomeView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:formType="input"
                    app:hintText="@string/please_enter"
                    app:inputBackgroundColor="@color/surface_primary"
                    app:inputFocusedStrokeColor="@color/brand_primary"
                    app:inputStrokeColor="@color/border_default"
                    app:inputType="number"
                    app:titleText="@string/calculator_additional_income" />

                <com.velora.portal.core.ui.component.FormItemView
                    android:id="@+id/deductionsView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:formType="input"
                    app:hintText="@string/please_enter"
                    app:inputBackgroundColor="@color/surface_primary"
                    app:inputFocusedStrokeColor="@color/brand_primary"
                    app:inputStrokeColor="@color/border_default"
                    app:inputType="number"
                    app:titleText="@string/calculator_deductions" />
            </LinearLayout>
        </com.velora.portal.core.ui.component.StyledConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.velora.portal.core.ui.component.StyledConstraintLayout
        android:id="@+id/analysisCard"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_340"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_16"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleBar"
        app:radius="@dimen/dp_12"
        app:solidColor="@color/surface_primary"
        app:strokeColor="@color/brand_primary"
        app:strokeWidth="@dimen/dp_1">

        <TextView
            android:id="@+id/tvAnalysisTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_14"
            android:layout_marginTop="@dimen/dp_14"
            android:includeFontPadding="false"
            android:text="@string/calculator_analysis"
            android:textColor="@color/text_body"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDeductionsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_14"
            android:layout_marginTop="@dimen/dp_20"
            android:includeFontPadding="false"
            android:text="@string/calculator_deductions"
            android:textColor="@color/text_body"
            android:textSize="@dimen/sp_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAnalysisTitle" />

        <TextView
            android:id="@+id/tvDeductionsValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_14"
            android:includeFontPadding="false"
            android:textColor="@color/brand_primary"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@id/tvDeductionsLabel"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvTaxableIncomeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_14"
            android:layout_marginTop="@dimen/dp_18"
            android:includeFontPadding="false"
            android:text="@string/calculator_taxable_income"
            android:textColor="@color/text_body"
            android:textSize="@dimen/sp_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDeductionsLabel" />

        <TextView
            android:id="@+id/tvTaxableIncomeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_14"
            android:includeFontPadding="false"
            android:textColor="@color/brand_primary"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@id/tvTaxableIncomeLabel"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvEstimatedTaxLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_14"
            android:layout_marginTop="@dimen/dp_18"
            android:includeFontPadding="false"
            android:text="@string/calculator_estimated_tax"
            android:textColor="@color/text_body"
            android:textSize="@dimen/sp_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTaxableIncomeLabel" />

        <TextView
            android:id="@+id/tvEstimatedTaxValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_14"
            android:includeFontPadding="false"
            android:textColor="@color/brand_primary"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@id/tvEstimatedTaxLabel"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvTakeHomeIncomeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_14"
            android:layout_marginTop="@dimen/dp_18"
            android:includeFontPadding="false"
            android:text="@string/calculator_take_home_income"
            android:textColor="@color/text_body"
            android:textSize="@dimen/sp_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEstimatedTaxLabel" />

        <TextView
            android:id="@+id/tvTakeHomeIncomeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_14"
            android:includeFontPadding="false"
            android:textColor="@color/brand_primary"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@id/tvTakeHomeIncomeLabel"
            app:layout_constraintEnd_toEndOf="parent" />
    </com.velora.portal.core.ui.component.StyledConstraintLayout>

    <com.velora.portal.core.ui.component.StatefulActionButton
        android:id="@+id/tvCalculate"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_16"
        android:text="@string/calculator_calculate"
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        app:buttonRadius="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
