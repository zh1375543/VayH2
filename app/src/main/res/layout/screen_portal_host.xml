<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@color/color_page_bg"
    android:layout_height="match_parent">

    <View
        android:id="@+id/topHeaderBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/brand_primary"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/ivCustomer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/vBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent" />

    <View
        android:id="@+id/vHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/vBottomNavigation"
        app:layout_constraintEnd_toStartOf="@id/vOrder"
        app:layout_constraintStart_toStartOf="@id/vBottomNavigation"
        app:layout_constraintTop_toTopOf="@id/vBottomNavigation" />

    <View
        android:id="@+id/vOrder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/vBottomNavigation"
        app:layout_constraintEnd_toStartOf="@id/vMine"
        app:layout_constraintStart_toEndOf="@id/vHome"
        app:layout_constraintTop_toTopOf="@id/vBottomNavigation" />

    <View
        android:id="@+id/vMine"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/vBottomNavigation"
        app:layout_constraintEnd_toEndOf="@id/vBottomNavigation"
        app:layout_constraintStart_toEndOf="@id/vOrder"
        app:layout_constraintTop_toTopOf="@id/vBottomNavigation" />

    <com.velora.portal.platform.design.component.StatefulLabelView
        android:id="@+id/tvHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableTop="@mipmap/ic_tab_home_unselect"
        android:text="@string/home"
        android:gravity="center"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/sp_12"
        app:labelSelectedDrawableTop="@mipmap/ic_tab_home_select"
        app:layout_constraintBottom_toBottomOf="@id/vHome"
        app:layout_constraintEnd_toEndOf="@id/vHome"
        app:layout_constraintStart_toStartOf="@id/vHome"
        app:layout_constraintTop_toTopOf="@id/vHome"
        app:labelSelectedTextColor="@color/brand_primary" />

    <com.velora.portal.platform.design.component.StatefulLabelView
        android:id="@+id/tvOrder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableTop="@mipmap/ic_tab_order_unselect"
        android:text="@string/Taborder"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/sp_12"
        android:gravity="center"
        app:labelSelectedDrawableTop="@mipmap/ic_tab_order_select"
        app:layout_constraintBottom_toBottomOf="@id/vOrder"
        app:layout_constraintEnd_toEndOf="@id/vOrder"
        app:layout_constraintStart_toStartOf="@id/vOrder"
        app:layout_constraintTop_toTopOf="@id/vOrder"
        app:labelSelectedTextColor="@color/brand_primary" />

    <com.velora.portal.platform.design.component.StatefulLabelView
        android:id="@+id/tvMine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableTop="@mipmap/ic_tab_profile_unselect"
        android:text="@string/mine"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/sp_12"
        android:gravity="center"
        app:labelSelectedDrawableTop="@mipmap/ic_tab_profile_select"
        app:layout_constraintBottom_toBottomOf="@id/vMine"
        app:layout_constraintEnd_toEndOf="@id/vMine"
        app:layout_constraintStart_toStartOf="@id/vMine"
        app:layout_constraintTop_toTopOf="@id/vMine"
        app:labelSelectedTextColor="@color/brand_primary" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivCustomer"
        android:layout_width="@dimen/dp_35"
        android:layout_height="@dimen/dp_35"
        android:padding="@dimen/sp_5"
        android:layout_marginEnd="@dimen/dp_16"
        android:layout_marginStart="@dimen/dp_10"
        android:scaleType="fitXY"
        android:src="@mipmap/image_message_ic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivMsg"
        android:layout_width="@dimen/dp_35"
        android:layout_height="@dimen/dp_35"
        android:src="@mipmap/image_contract_ic"
        android:scaleType="fitXY"
        android:padding="@dimen/sp_5"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="@id/ivCustomer"
        app:layout_constraintEnd_toStartOf="@id/ivCustomer"
        app:layout_constraintTop_toTopOf="@id/ivCustomer" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAppIcon"
        android:layout_width="@dimen/dp_38"
        android:layout_height="@dimen/dp_38"
        android:layout_marginStart="@dimen/dp_16"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher"
        app:layout_constraintBottom_toBottomOf="@id/ivCustomer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivCustomer"
        app:shapeAppearanceOverlay="@style/Round_6" />

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_44"
        android:layout_marginStart="@dimen/dp_8"
        android:gravity="center_vertical"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/sp_20"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ivCustomer"
        app:layout_constraintEnd_toStartOf="@id/ivCustomer"
        app:layout_constraintStart_toEndOf="@id/ivAppIcon"
        app:layout_constraintTop_toTopOf="@id/ivCustomer" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/topGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ivAppIcon,tvAppName" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpMain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/vBottomNavigation"
        app:layout_constraintTop_toBottomOf="@id/ivCustomer" />

</androidx.constraintlayout.widget.ConstraintLayout>
