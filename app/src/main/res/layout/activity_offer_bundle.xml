<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg_color1">

    <com.velora.portal.core.ui.component.PageHeaderView
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:centerText="@string/loan_application"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomCard"
        app:layout_constraintTop_toBottomOf="@id/titleBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.velora.portal.core.ui.component.StyledRecyclerView
                android:id="@+id/rvBundleList"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_10"
                android:orientation="vertical"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/dp_4"
                android:clipToPadding="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:solidColor="@color/transparent"
                tools:itemCount="2"
                tools:listitem="@layout/item_combo" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.velora.portal.core.ui.component.PageStateOverlayView
            android:id="@+id/pageState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true" />
    </FrameLayout>

    <com.velora.portal.core.ui.component.StyledConstraintLayout
        android:id="@+id/bottomCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_10"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingTop="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:solidColor="@color/surface_primary">

        <TextView
            android:id="@+id/tvAccountTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/account_receivable"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/sp_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/accountInfoLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_8"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/tvAccountTitle"
            app:layout_constraintEnd_toStartOf="@id/btnSwitchAccount"
            app:layout_constraintTop_toTopOf="@id/tvAccountTitle">

            <TextView
                android:id="@+id/tvPayWay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                tools:text="card" />

            <TextView
                android:id="@+id/tvAccountNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                tools:text="111111" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <com.velora.portal.core.ui.component.StyledTextView
            android:id="@+id/btnSwitchAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dp_12"
            android:paddingVertical="@dimen/dp_8"
            android:text="@string/change"
            android:textColor="@color/text_inverse"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toBottomOf="@id/tvAccountTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvAccountTitle"
            app:radius="@dimen/dp_15"
            app:solidColor="@color/brand_primary" />

        <com.velora.portal.core.ui.component.StyledConstraintLayout
            android:id="@+id/walletTipPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:padding="@dimen/dp_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAccountTitle"
            app:radius="@dimen/dp_16"
            app:solidColor="@color/color_verify_tip">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivLoanTip"
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:src="@mipmap/ic_loan_tip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvLoanTip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:lineSpacingExtra="@dimen/dp_2"
                android:text="@string/loan_account_tip"
                android:textColor="@color/action_withdraw"
                android:textSize="@dimen/sp_11"
                app:layout_constraintBottom_toBottomOf="@id/ivLoanTip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivLoanTip"
                app:layout_constraintTop_toTopOf="@id/ivLoanTip" />
        </com.velora.portal.core.ui.component.StyledConstraintLayout>

        <com.velora.portal.core.ui.component.StyledConstraintLayout
            android:id="@+id/repaymentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            app:layout_goneMarginTop="@dimen/dp_15"
            android:paddingTop="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_10"
            app:layout_constraintTop_toBottomOf="@id/walletTipPanel"
            app:radius="@dimen/dp_30"
            app:solidColor="@color/surface_primary">

            <TextView
                android:id="@+id/tvRepaymentTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_Loan"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/sp_14"
                app:layout_constraintBottom_toBottomOf="@id/tvTotalAmount"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvTotalAmount" />

            <TextView
                android:id="@+id/tvTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/brand_primary"
                android:textSize="@dimen/sp_18"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="500,000,000₫" />

            <TextView
                android:id="@+id/tvTransactionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/together_num"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/sp_14"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTotalAmount" />

            <TextView
                android:id="@+id/tvBundleCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sp_18"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tvTransactionTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvTransactionTitle"
                tools:text="3" />

            <com.velora.portal.core.ui.component.StatefulActionButton
                android:id="@+id/btnWithdraw"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/withdrawal"
                android:textSize="@dimen/sp_18"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTransactionTitle" />
        </com.velora.portal.core.ui.component.StyledConstraintLayout>
    </com.velora.portal.core.ui.component.StyledConstraintLayout>

    <androidx.constraintlayout.widget.Group
        android:id="@+id/bottomUiGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="bottomCard"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
